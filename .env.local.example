# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser. Used by the
# reminders cron and admin actions (lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
REMINDERS_FROM_EMAIL="Compliance Reminders <reminders@yourdomain.com>"

# Twilio — https://console.twilio.com (fast-follow SMS reminder channel,
# alongside email; leave blank to skip SMS entirely — see app/api/cron/reminders/route.ts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Shared secret Vercel Cron sends as a Bearer token so /api/cron/reminders
# can't be triggered by anyone else. Generate with: openssl rand -hex 32
CRON_SECRET=
VERCEL_API_KEY=svl_9526a34e5f7469b5ab096b0a5ee67b3310f46835f3a4b1a7ad2bb03d9c295cbf